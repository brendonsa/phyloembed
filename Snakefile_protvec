configfile: "config/config.yaml"

RESULTS_DIR = "results"
METRICS = config["metrics"]
PROTVEC_VECTORS = config.get("protvec_vectors", "data/protVec_100d_3grams.csv")


rule all:
    input:
        expand(
            "results/{dataset}/tree_distances_vs_ref_protvec.csv",
            dataset=config["datasets"],
        )


rule extract_protvec:
    input:
        fasta = RESULTS_DIR + "/{dataset}/translated.fasta",
        vectors = PROTVEC_VECTORS
    output:
        csv = RESULTS_DIR + "/{dataset}/embeddings/protvec_alignment.csv"
    conda:
        "phyloembed"
    shell:
        """
        python scripts/extract_protvec.py \
            --input {input.fasta} \
            --vectors {input.vectors} \
            --output {output.csv} \
            --pooling mean
        """


rule compute_distance_matrix_protvec:
    input:
        csv = rules.extract_protvec.output.csv
    output:
        dist = RESULTS_DIR + "/{dataset}/distances_protvec_{metric}.csv"
    conda:
        "phyloembed"
    shell:
        """
        python scripts/compute_distance_matrix_phylip.py \
            --input {input.csv} \
            --output {output.dist} \
            --metric {wildcards.metric}
        """


rule build_nj_tree_protvec:
    input:
        dist = rules.compute_distance_matrix_protvec.output.dist
    output:
        tree = RESULTS_DIR + "/{dataset}/tree_nj_alignment_protvec_{metric}.nwk"
    conda:
        "phyloembed"
    shell:
        "fastme -i {input.dist} -o {output.tree} --nni --spr -q  -T 8 >/dev/null"


rule extract_protvec_raw:
    input:
        fasta = RESULTS_DIR + "/{dataset}/aligned.fasta",
        vectors = PROTVEC_VECTORS
    output:
        npz = RESULTS_DIR + "/{dataset}/embeddings/protvec_raw.npz"
    conda:
        "phyloembed"
    shell:
        """
        python scripts/extract_protvec.py \
            --input {input.fasta} \
            --vectors {input.vectors} \
            --output {output.npz} \
            --pooling concat
        """


rule window_distances_protvec:
    input:
        emb = rules.extract_protvec_raw.output.npz
    output:
        joined = RESULTS_DIR + "/{dataset}/windows_protvec/model=protvec__metric={metric}__w=1__ov=0/joined.phy",
        meta = RESULTS_DIR + "/{dataset}/windows_protvec/model=protvec__metric={metric}__w=1__ov=0/windows.json"
    conda:
        "phyloembed"
    shell:
        """
        python scripts/build_window_distances.py \
            --embeddings {input.emb} \
            --outdir $(dirname {output.joined}) \
            --window-size 1 \
            --overlap 0 \
            --metric {wildcards.metric} \
            --reduce mean
        """


rule window_phy_to_tree_protvec:
    input:
        dist = rules.window_distances_protvec.output.joined
    output:
        tree = RESULTS_DIR + "/{dataset}/tree_nj_windows_protvec_{metric}_w1_ov0.nwk"
    conda:
        "phyloembed"
    shell:
        "fastme -i {input.dist} -o {output.tree} --nni --spr -q  -T 8 >/dev/null"


rule tree_distances_vs_ref_protvec:
    input:
        old_csv = RESULTS_DIR + "/{dataset}/tree_distances_vs_ref.csv",
        pooled_trees = expand(
            RESULTS_DIR + "/{{dataset}}/tree_nj_alignment_protvec_{metric}.nwk",
            metric=METRICS,
        ),
        windowed_trees = expand(
            RESULTS_DIR + "/{{dataset}}/tree_nj_windows_protvec_{metric}_w1_ov0.nwk",
            metric=METRICS,
        )
    output:
        csv = RESULTS_DIR + "/{dataset}/tree_distances_vs_ref_protvec.csv"
    conda:
        "phyloembed"
    params:
        dataset_dir = RESULTS_DIR + "/{dataset}"
    shell:
        """
        Rscript scripts/compare_all_trees.r \
            --dataset-dir {params.dataset_dir} \
            --out {output.csv}
        """
