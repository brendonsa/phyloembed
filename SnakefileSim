configfile: "config/config.yaml"

trees_cfg = config["trees"]
simphy_cfg = config["simphy"]

trees_out = trees_cfg["out_dir"]
sim_out = simphy_cfg["out_dir"]

leaves = trees_cfg["leaves"]
n_per_leaf = int(trees_cfg["n_per_leaf"])
idxs = [f"{i:02d}" for i in range(1, n_per_leaf + 1)]

ps_values = simphy_cfg["ps_values"]
dl_values = simphy_cfg["dl_values"]

include: "rules/tree_sim2.smk"

rule all:
    input:
        expand(f"{trees_out}/L{{leaf}}_{{idx}}.nwk", leaf=leaves, idx=idxs),
        expand(f"{trees_out}/L{{leaf}}_{{idx}}.trees", leaf=leaves, idx=idxs),
        expand(f"{trees_out}/L{{leaf}}_{{idx}}.node_times.tsv", leaf=leaves, idx=idxs),
        expand(
            f"{sim_out}/L{{leaf}}_{{idx}}/ps{{ps}}_dl{{dl}}/done.txt",
            leaf=leaves,
            idx=idxs,
            ps=ps_values,
            dl=dl_values,
        )
