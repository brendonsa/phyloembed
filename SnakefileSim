configfile: "config/configSim.yaml"

import os
from snakemake.io import glob_wildcards

MODES = ["alignment", "non_aligned"]
BOOTKINDS = []
POOLINGS = [""]  # Empty string = no suffix = mean pooling (default)

sim_cfg = config.get("sim_parse", {})
sim_datasets = config.get("sim_datasets", [])
sim_reps = int(config.get("sim_replicates", 0))
RESULTS_DIR = sim_cfg.get("output_dir", config.get("results_dir", "results"))

def simulated_dataset_ids():
    rep_ids = [f"replicate_{i:03d}" for i in range(1, sim_reps + 1)]
    return [f"{d}/{r}" for d in sim_datasets for r in rep_ids]

def existing_simulated_dataset_ids():
    pattern = os.path.join(sim_cfg.get("input_dir", "simulations/raw"), "{dataset}", "gene_tree.nwk")
    datasets = glob_wildcards(pattern).dataset
    base = sim_cfg.get("input_dir", "simulations/raw")
    unaligned_name = "alignment.unaligned.fa"
    return [
        d
        for d in datasets
        if os.path.exists(os.path.join(base, d, "alignment_TRUE.phy"))
        or os.path.exists(os.path.join(base, d, unaligned_name))
    ]

if config.get("sim_filter_existing", True):
    SIM_DATASETS = existing_simulated_dataset_ids()
else:
    SIM_DATASETS = simulated_dataset_ids()

include: "rules/sim_parse.smk"
include: "rules/embeddings.smk"
include: "rules/phyloformer.smk"

rule all:
    input:
        distances = expand(
            RESULTS_DIR + "/{dataset}/tree_distances_vs_ref.csv",
            dataset=SIM_DATASETS,
        ),
        raw_embeddings = expand(
            RESULTS_DIR + "/{dataset}/embeddings/{model}_raw.npz",
            dataset=SIM_DATASETS,
            model=config["models_concat"],
        )


rule tree_distances_vs_ref:
    input:
        ref=RESULTS_DIR + "/{dataset}/tree.nwk",
        plm=lambda wc: [
            f"{RESULTS_DIR}/{wc.dataset}/tree_nj_{mode}_{model}_{metric}.nwk"
            for mode in MODES
            for model in config["models"]
            for metric in config["metrics"]
        ] + [
            f"{RESULTS_DIR}/{wc.dataset}/tree_nj_alignment_msapairformer_{metric}.nwk"
            for metric in config["metrics"]
        ],
        emb=lambda wc: [
            f"{RESULTS_DIR}/{wc.dataset}/{bootkind}_tree_nj_embedding_{model}_{metric}_with_support.nwk"
            for bootkind in BOOTKINDS
            for model in config["models"]
            for metric in config["metrics"]
        ],
        phyloformer=RESULTS_DIR + "/{dataset}/phyloformer.nwk",
        weighted_subset_majority=lambda wc: [
            f"{RESULTS_DIR}/{wc.dataset}/consensus_weighted_{model}_{metric}_{wkind}_inc0{inc0}_{coverage}pct_{nsubsets}_seed{seed}_majority.nwk"
            for model in config["models_concat"]
            for metric in config["metrics"]
            for wkind in config["weights"]
            for inc0 in config.get("include_zero", [0])
            for coverage in config["subsets"]["coverage_percentages"]
            for nsubsets in config["subsets"]["repetition_counts"]
            for seed in [config["subsets"]["seed"]]
        ],
        weighted_subset_greedy=lambda wc: [
            f"{RESULTS_DIR}/{wc.dataset}/consensus_weighted_{model}_{metric}_{wkind}_inc0{inc0}_{coverage}pct_{nsubsets}_seed{seed}_greedy.nwk"
            for model in config["models_concat"]
            for metric in config["metrics"]
            for wkind in config["weights"]
            for inc0 in config.get("include_zero", [0])
            for coverage in config["subsets"]["coverage_percentages"]
            for nsubsets in config["subsets"]["repetition_counts"]
            for seed in [config["subsets"]["seed"]]
        ],
        window_trees=lambda wc: [
            f"{RESULTS_DIR}/{wc.dataset}/tree_nj_windows_{model}_{metric}_w{winsize}_ov{overlap}.nwk"
            for model in config["models_concat"]
            for metric in config["metrics"]
            for winsize in config["windows"]["sizes"]
            for overlap in config["windows"]["overlaps"]
        ] + [
            f"{RESULTS_DIR}/{wc.dataset}/tree_nj_windows_{model}_{metric}_w1_ov0.nwk"
            for model in config["models_concat"]
            for metric in config["metrics"]
        ],
        sorted_cov_trees=lambda wc: [
            f"{RESULTS_DIR}/{wc.dataset}/tree_nj_sortedcov_{model}_{metric}_{wkind}_inc0{inc0}_{coverage}pct_{direction}_{norm}.nwk"
            for model in config["models_concat"]
            for metric in config["metrics"]
            for wkind in config["weights"]
            for inc0 in config["sorted_coverage"]["include_zero"]
            for coverage in config["sorted_coverage"]["coverage_percentages"]
            for direction in config["sorted_coverage"]["directions"]
            for norm in config["sorted_coverage"]["normalize"]
        ]
    conda:
        "phyloembed"
    params:
        dataset_dir = RESULTS_DIR + "/{dataset}"
    output:
        RESULTS_DIR + "/{dataset}/tree_distances_vs_ref.csv"
    shell:
        """
        Rscript scripts/compare_all_trees.r \
            --dataset-dir {params.dataset_dir} \
            --out {output}
        """
